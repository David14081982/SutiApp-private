SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Administrative/server-side use only. Never expose these values to the frontend.
SUPABASE_SECRET_KEY=your_server_side_secret_key
SUPABASE_ACCESS_TOKEN=your_management_access_token
SUPABASE_DB_PASSWORD=your_database_password

# Optional legacy server-side key; prefer SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=your_legacy_service_role_key
